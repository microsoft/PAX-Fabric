{
  "properties": {
    "activities": [
      {
        "name": "RunPaxNotebook",
        "type": "TridentNotebook",
        "dependsOn": [],
        "policy": {
          "timeout": "12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId":  "__NOTEBOOK_ID__",
          "workspaceId": "__WORKSPACE_ID__",
          "parameters": {
            "StartDate":        { "value": "@pipeline().parameters.StartDate",        "type": "string" },
            "EndDate":          { "value": "@pipeline().parameters.EndDate",          "type": "string" },
            "NumberOfDays":     { "value": "@pipeline().parameters.NumberOfDays",     "type": "int"    },
            "Dashboard":           { "value": "@pipeline().parameters.Dashboard",           "type": "string" },
            "IncludeM365Usage": { "value": "@pipeline().parameters.IncludeM365Usage", "type": "bool"   },
            "Rollup":           { "value": "@pipeline().parameters.Rollup",           "type": "bool"   },
            "RollupPlusRaw":       { "value": "@pipeline().parameters.RollupPlusRaw",       "type": "bool"   },
            "CombinedOutput":      { "value": "@pipeline().parameters.CombinedOutput",      "type": "bool"   },
            "FillerLabel":         { "value": "@pipeline().parameters.FillerLabel",         "type": "string" },
            "FillerLabelText":     { "value": "@pipeline().parameters.FillerLabelText",     "type": "string" },
            "IncludeUserInfo":  { "value": "@pipeline().parameters.IncludeUserInfo",  "type": "bool"   },
            "OnlyUserInfo":     { "value": "@pipeline().parameters.OnlyUserInfo",     "type": "bool"   },
            "UserHistory":          { "value": "@pipeline().parameters.UserHistory",          "type": "string" },
            "HistoryEffectiveDate": { "value": "@pipeline().parameters.HistoryEffectiveDate", "type": "string" },
            "UserInfoSupplement":  { "value": "@pipeline().parameters.UserInfoSupplement",  "type": "string" },
            "IncludeAgent365Info": { "value": "@pipeline().parameters.IncludeAgent365Info", "type": "bool"   },
            "OnlyAgent365Info":    { "value": "@pipeline().parameters.OnlyAgent365Info",    "type": "bool"   },
            "GroupNames":          { "value": "@pipeline().parameters.GroupNames",          "type": "string" },
            "UserIds":             { "value": "@pipeline().parameters.UserIds",             "type": "string" },
            "Deidentify":          { "value": "@pipeline().parameters.Deidentify",          "type": "bool"   },
            "Watermark":            { "value": "@pipeline().parameters.Watermark",            "type": "bool"   },
            "WatermarkStartDate":   { "value": "@pipeline().parameters.WatermarkStartDate",   "type": "string" },
            "PurviewInputFile":     { "value": "@pipeline().parameters.PurviewInputFile",     "type": "string" },
            "PurviewInputTable":    { "value": "@pipeline().parameters.PurviewInputTable",    "type": "string" },
            "UserInfoFile":         { "value": "@pipeline().parameters.UserInfoFile",         "type": "string" },
            "Resume":               { "value": "@pipeline().parameters.Resume",               "type": "string" },
            "EmitMetricsJson":      { "value": "@pipeline().parameters.EmitMetricsJson",      "type": "bool"   },
            "MetricsPath":          { "value": "@pipeline().parameters.MetricsPath",          "type": "string" },
            "ExtraParamsJson":      { "value": "@pipeline().parameters.ExtraParamsJson",      "type": "string" }
          }
        }
      }
    ],
    "parameters": {
      "StartDate":        { "type": "string", "defaultValue": "" },
      "EndDate":          { "type": "string", "defaultValue": "" },
      "NumberOfDays":     { "type": "int",    "defaultValue": 0     },
      "Dashboard":           { "type": "string", "defaultValue": ""    },
      "IncludeM365Usage": { "type": "bool",   "defaultValue": true  },
      "Rollup":           { "type": "bool",   "defaultValue": true  },
      "RollupPlusRaw":       { "type": "bool",   "defaultValue": false },
      "CombinedOutput":      { "type": "bool",   "defaultValue": false },
      "FillerLabel":         { "type": "string", "defaultValue": ""    },
      "FillerLabelText":     { "type": "string", "defaultValue": ""    },
      "IncludeUserInfo":  { "type": "bool",   "defaultValue": true  },
      "OnlyUserInfo":     { "type": "bool",   "defaultValue": false },
      "UserHistory":          { "type": "string", "defaultValue": "Off" },
      "HistoryEffectiveDate": { "type": "string", "defaultValue": ""    },
      "UserInfoSupplement":  { "type": "string", "defaultValue": ""    },
      "IncludeAgent365Info": { "type": "bool",   "defaultValue": false },
      "OnlyAgent365Info":    { "type": "bool",   "defaultValue": false },
      "GroupNames":          { "type": "string", "defaultValue": ""    },
      "UserIds":             { "type": "string", "defaultValue": ""    },
      "Deidentify":          { "type": "bool",   "defaultValue": false },
      "Watermark":            { "type": "bool",   "defaultValue": false },
      "WatermarkStartDate":   { "type": "string", "defaultValue": ""    },
      "PurviewInputFile":     { "type": "string", "defaultValue": ""    },
      "PurviewInputTable":    { "type": "string", "defaultValue": ""    },
      "UserInfoFile":         { "type": "string", "defaultValue": ""    },
      "Resume":               { "type": "string", "defaultValue": ""    },
      "EmitMetricsJson":      { "type": "bool",   "defaultValue": false },
      "MetricsPath":          { "type": "string", "defaultValue": ""    },
      "ExtraParamsJson":      { "type": "string", "defaultValue": "{}"  }
    },
    "annotations": []
  }
}
